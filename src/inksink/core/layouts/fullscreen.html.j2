<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    @import url('/usr/share/fonts/noto/NotoSans-Regular.ttf');
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      font-family: 'Noto Sans', 'Noto Sans CJK JP', sans-serif;
    }
    .content {
      width: 100vw;
      height: 100vh;
    }
  </style>
</head>
<body>
  <div class="content">{{ content | safe }}</div>
</body>
</html>
