<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    @font-face {
      font-family: 'Noto Sans';
      src: url('/usr/share/fonts/noto/NotoSans-Regular.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100vw;
      font-family: 'Noto Sans', 'Noto Sans CJK JP', sans-serif;
      font-size: 14px;
    }
    .progress {
      width: 100vw;
      height: {{ progress_bar_height }}px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 0 8px;
      font-size: 12px;
      color: #555;
      border-bottom: 1px solid #eee;
    }
    .content {
      width: 100vw;
      padding: 8px;
    }
  </style>
</head>
<body>
  <div class="progress">{{ progress }}</div>
  <div class="content">{{ content | safe }}</div>
</body>
</html>
